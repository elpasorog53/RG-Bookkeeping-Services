# Application
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="rg_session"

# Database (Supabase Postgres connection string; use the pooler URL in production)
DATABASE_URL="your-database-url"
DB_SSL="false"

# Secrets encryption (64 hex chars; generate with: openssl rand -hex 32)
CONFIG_ENCRYPTION_KEY="your-64-hex-encryption-key"

# Storage (Supabase project)
SUPABASE_URL="your-supabase-project-url"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
STORAGE_BUCKET_MEDIA="rg-media"

# AI (can also be stored encrypted in app_config via Settings)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Email (verification + password reset)
SMTP_HOST="your-smtp-host"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
MAIL_FROM="RG Bookkeeping <no-reply@example.com>"
